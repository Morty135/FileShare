# Database Configuration
DATABASE_URL=mongodb://mongodb:27017/FileShare

# Application Configuration
PORT=3000
NODE_ENV=production

# File Upload Configuration
MAX_FILE_SIZE=1073741824 # 1GB in bytes (adjust as needed)
UPLOAD_PATH=/app/uploads

# Cloudflare Configuration
CF_MAX_REQUEST_SIZE=1073741824 # 1GB in bytes - matches MAX_FILE_SIZE
CF_MAX_RESPONSE_SIZE=1073741824 # 1GB in bytes

# Security Configuration
SESSION_SECRET=your-secret-key-here-change-this-in-production